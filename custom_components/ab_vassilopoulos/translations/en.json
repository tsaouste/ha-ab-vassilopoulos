{
  "config": {
    "step": {
      "user": {
        "title": "Connect AB Vassilopoulos",
        "description": "Use **one** browser (Edge or Firefox, not both). Cookie values differ per browser because each has its own login session — either works if you are signed in on the Greek site (ab.gr).\n\n1. Open [{login_url}]({login_url}) and sign in.\n2. Enable **Keep me signed in / Remember me** on the login form.\n3. Press F12 → **Network**.\n4. Press F5.\n5. Filter `api/v1` → click the first row.\n6. **Headers** → **Request Headers** → **Cookie** (not Set-Cookie).\n7. Right-click → Copy value.\n8. Paste into the box below.",
        "data": {
          "cookie_header": "Cookie line"
        },
        "data_description": {
          "cookie_header": "A long line like name=value; name2=value2; …  Not a URL and not your password."
        }
      },
      "reauth_confirm": {
        "title": "Reconnect AB Vassilopoulos",
        "description": "Use **one** browser (Edge or Firefox, not both). Cookie values differ per browser because each has its own login session — either works if you are signed in on the Greek site (ab.gr).\n\n1. Open [{login_url}]({login_url}) and sign in.\n2. Enable **Keep me signed in / Remember me** on the login form.\n3. Press F12 → **Network**.\n4. Press F5.\n5. Filter `api/v1` → click the first row.\n6. **Headers** → **Request Headers** → **Cookie** (not Set-Cookie).\n7. Right-click → Copy value.\n8. Paste into the box below.",
        "data": {
          "cookie_header": "Cookie line"
        },
        "data_description": {
          "cookie_header": "A long line like name=value; name2=value2; …  Not a URL and not your password."
        }
      }
    },
